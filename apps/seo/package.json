{
  "name": "seo",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "dotenvx decrypt -f ../../.env --stdout > .env.local && node -e \"const fs=require('node:fs'); const p='../../.env.local'; if (fs.existsSync(p)) fs.appendFileSync('.env.local', fs.readFileSync(p));\" && pnpm cf-typegen && pnpm with-env-local vite",
    "build:local": "pnpm with-env-local vite build",
    "build:preview": "pnpm with-env-preview vite build ",
    "build:production": "pnpm with-env-production vite build",
    "serve:local": "pnpm with-env-local vite preview",
    "test": "vitest run",
    "clean": "git clean -xdf .turbo node_modules dist .cache .wrangler",
    "format": "pnpx @biomejs/biome format . --write",
    "lint": "pnpx @biomejs/biome lint . --write",
    "typecheck": "pnpm cf-typegen && pnpm tsc --noEmit --emitDeclarationOnly false",
    "with-env-local": "dotenvx run  -f ../../.env.local -f ../../.env -- ",
    "with-env-preview": "dotenvx run  -f ../../.env -- ",
    "with-env-production": "dotenvx run  -f ../../.env.production -- ",
    "wrangler": "wrangler",
    "cf-typegen": "wrangler types --env-interface Env"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.319",
    "@posthog/react": "^1.11.3",
    "@rectangular-labs/api-seo": "workspace:*",
    "@rectangular-labs/api-user-vm": "workspace:*",
    "@rectangular-labs/auth": "workspace:*",
    "@rectangular-labs/content": "workspace:*",
    "@rectangular-labs/core": "workspace:*",
    "@rectangular-labs/db": "workspace:*",
    "@rectangular-labs/loro-file-system": "workspace:^",
    "@rectangular-labs/result": "workspace:*",
    "@rectangular-labs/ui": "workspace:*",
    "@stepperize/react": "^5.1.9",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.316",
    "arktype": "^2.2.9",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "loro-crdt": "^1.17.1",
    "loro-mirror": "1.2.1",
    "loro-mirror-react": "1.2.1",
    "motion": "^12.43.0",
    "partysocket": "^1.3.0",
    "posthog-js": "^1.438.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tanstack-router-sitemap": "^1.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@rectangular-labs/typescript": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-mkcert": "^1.17.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "web-vitals": "^5.3.0",
    "wrangler": "^4.153.0"
  }
}
